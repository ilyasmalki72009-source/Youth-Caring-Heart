/* ================= RESET ================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
  background: #ffffff;
  line-height: 1.6;
}

/* ================= VARIABLES ================= */

:root {
  --primary: #e11d48;
  --primary-dark: #be123c;

  --text: #1f2937;
  --text-secondary: #374151;
  --muted: #6b7280;

  --border: #d1d5db;

  --light-bg: #f8fafc;
  --input-bg: #ffffff;

  --dark: #111827;
  --dark-card: #1f2937;
  --dark-secondary: #374151;

  --success-bg: #ecfdf5;
  --success-bg-light: #f0fdf4;

  --shadow-small: 0 3px 15px rgba(0, 0, 0, 0.08);
  --shadow-medium: 0 7px 25px rgba(0, 0, 0, 0.07);
  --shadow-large: 0 10px 35px rgba(0, 0, 0, 0.08);

  --radius-small: 9px;
  --radius-medium: 12px;
  --radius-large: 18px;
}

/* ================= ACCESSIBILITY ================= */

a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid #fda4af;
  outline-offset: 3px;
}

/* ================= HEADER ================= */

.header {
  position: sticky;
  top: 0;
  z-index: 1000;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 18px 7%;

  background: rgba(255, 255, 255, 0.96);

  box-shadow: 0 3px 20px rgba(0, 0, 0, 0.08);

  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.logo {
  color: var(--primary);
  text-decoration: none;

  font-size: 21px;
  font-weight: 800;
}

nav {
  display: flex;
  gap: 22px;
}

nav a {
  color: var(--text-secondary);
  text-decoration: none;
  font-weight: 600;

  transition: color 0.2s ease;
}

nav a:hover {
  color: var(--primary);
}

.menu-button {
  display: none;

  border: none;
  background: transparent;
  color: var(--text);

  font-size: 25px;
  padding: 5px;

  cursor: pointer;
}

/* ================= HERO ================= */

.hero {
  min-height: 86vh;

  display: flex;
  align-items: center;

  padding: 80px 8%;

  background: linear-gradient(
    135deg,
    #ffe4e6,
    #fef3c7,
    #ecfeff
  );
}

.hero-content {
  max-width: 820px;
}

.hero-badge {
  display: inline-block;

  margin-bottom: 20px;
  padding: 8px 15px;

  border-radius: 30px;

  background: rgba(255, 255, 255, 0.85);

  color: var(--primary-dark);

  font-weight: bold;
}

.hero h1 {
  max-width: 800px;

  font-size: clamp(45px, 7vw, 78px);

  line-height: 1.02;

  margin-bottom: 25px;
}

.hero p {
  max-width: 680px;

  font-size: 20px;

  color: #4b5563;

  margin-bottom: 32px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

/* ================= BUTTONS ================= */

.button {
  display: inline-block;

  border: none;
  border-radius: 10px;

  padding: 13px 22px;

  font-size: 15px;
  font-weight: bold;

  text-decoration: none;

  cursor: pointer;

  transition:
    transform 0.2s ease,
    background-color 0.2s ease,
    box-shadow 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.primary {
  background: var(--primary);
  color: white;
}

.primary:hover {
  background: var(--primary-dark);
}

.secondary {
  background: white;
  color: var(--primary-dark);

  box-shadow: var(--shadow-small);
}

.secondary:hover {
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
}

.white-button {
  background: white;
  color: var(--primary-dark);
}

/* ================= ANNOUNCEMENT ================= */

.announcement-section {
  padding: 35px 8%;
}

.announcement-banner {
  max-width: 1200px;
  margin: auto;

  padding: 30px 35px;

  border-radius: var(--radius-large);

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 25px;

  background: linear-gradient(
    135deg,
    var(--primary),
    var(--primary-dark)
  );

  color: white;

  box-shadow:
    0 10px 30px rgba(190, 18, 60, 0.22);
}

.announcement-label {
  font-size: 13px;
  font-weight: bold;
  opacity: 0.85;
}

.announcement-banner h2 {
  margin-top: 5px;
}

.announcement-banner p {
  opacity: 0.9;
}

/* ================= SECTIONS ================= */

section {
  padding: 90px 8%;
}

.gray-section {
  background: var(--light-bg);
}

.section-heading {
  max-width: 780px;
  margin: 0 auto 45px;

  text-align: center;
}

.small-title {
  display: block;

  margin-bottom: 8px;

  color: var(--primary);

  font-size: 13px;
  font-weight: 800;
  letter-spacing: 2px;
}

.section-heading h2 {
  font-size: clamp(30px, 5vw, 45px);

  line-height: 1.15;

  margin-bottom: 15px;
}

.section-heading p {
  color: var(--muted);
}

/* ================= CARDS ================= */

.cards {
  max-width: 1150px;

  margin: auto;

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 25px;
}

.card,
.project-card {
  padding: 32px;

  background: white;

  border-radius: var(--radius-large);

  box-shadow: var(--shadow-medium);
}

.card-icon {
  font-size: 42px;
  margin-bottom: 12px;
}

.card h3,
.project-card h3 {
  margin-bottom: 10px;
}

.card p,
.project-card p {
  color: var(--muted);
}

.project-card {
  text-align: left;
}

.project-card > span {
  display: block;

  font-size: 40px;

  margin-bottom: 15px;
}

/* ================= FORM ================= */

.registration-form {
  max-width: 850px;
  margin: auto;
}

.form-row {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 18px;
}

.form-group {
  display: flex;
  flex-direction: column;

  gap: 7px;

  margin-bottom: 18px;

  text-align: left;
}

.form-group label {
  font-weight: 700;
}

input,
textarea,
select {
  width: 100%;

  border: 1px solid var(--border);

  border-radius: var(--radius-small);

  padding: 14px 15px;

  font: inherit;

  background: var(--input-bg);
  color: var(--text);

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

textarea {
  min-height: 140px;
  resize: vertical;
}

input:focus,
textarea:focus,
select:focus {
  outline: none;

  border-color: var(--primary);

  box-shadow:
    0 0 0 3px rgba(225, 29, 72, 0.1);
}

.privacy-check {
  display: flex;

  gap: 10px;

  align-items: flex-start;

  text-align: left;

  margin: 10px 0 20px;

  font-size: 14px;

  color: var(--muted);
}

.privacy-check input {
  width: auto;
  margin-top: 5px;
}

.submit-button {
  width: 100%;
}

.message {
  margin-top: 12px;

  text-align: center;

  font-weight: bold;
}

/* ================= SUCCESS ================= */

.profile-success {
  background: linear-gradient(
    135deg,
    var(--success-bg),
    var(--success-bg-light)
  );

  text-align: center;
}

.success-card {
  max-width: 600px;

  margin: auto;

  padding: 45px;

  background: white;

  border-radius: 22px;

  box-shadow: var(--shadow-large);
}

.success-icon {
  font-size: 55px;
  margin-bottom: 15px;
}

.member-id-box {
  margin: 25px 0;

  padding: 20px;

  border-radius: var(--radius-medium);

  background: #fff1f2;
}

.member-id-box span {
  display: block;

  color: var(--muted);

  font-size: 13px;
}

.member-id-box strong {
  display: block;

  margin-top: 5px;

  color: var(--primary-dark);

  font-size: 28px;

  letter-spacing: 2px;
}

.small-text {
  color: var(--muted);
  margin-bottom: 20px;
}

/* ================= AI ================= */

.ai-container {
  max-width: 800px;

  margin: auto;

  padding: 20px;

  background: white;

  border-radius: 20px;

  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
}

.ai-messages {
  height: 350px;

  overflow-y: auto;

  padding: 18px;

  border-radius: 13px;

  background: #f3f4f6;

  margin-bottom: 15px;
}

.ai-message {
  max-width: 85%;

  padding: 12px 16px;

  border-radius: 13px;

  margin-bottom: 12px;

  overflow-wrap: anywhere;
}

.bot-message {
  background: #e5e7eb;
}

.user-message {
  margin-left: auto;

  background: #ffe4e6;
}

.ai-input-area {
  display: flex;
  gap: 10px;
}

.ai-input-area input {
  flex: 1;
}

/* ================= ADMIN ================= */

.admin-section {
  background: var(--dark);
  color: white;
}

.admin-section .section-heading p {
  color: #9ca3af;
}

.admin-login {
  max-width: 450px;

  margin: auto;

  padding: 30px;

  border-radius: var(--radius-large);

  background: var(--dark-card);
}

.admin-login form {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.dashboard {
  max-width: 1150px;
  margin: auto;
}

.dashboard-header {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  margin-bottom: 30px;
}

.dashboard-header h2 {
  font-size: 35px;
}

.logout-button {
  background: var(--dark-secondary);
  color: white;
}

.statistics {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 20px;

  margin-bottom: 25px;
}

.stat-card {
  padding: 25px;

  border-radius: 15px;

  background: var(--dark-card);

  text-align: center;
}

.stat-card span {
  display: block;

  font-size: 30px;
}

.stat-card strong {
  display: block;

  font-size: 30px;
}

.stat-card small {
  color: #9ca3af;
}

.admin-panel {
  margin-bottom: 30px;

  padding: 25px;

  border-radius: var(--radius-large);

  background: var(--dark-card);
}

.admin-panel h3 {
  margin-bottom: 20px;
}

.search-input {
  margin-bottom: 20px;
}

.member-card {
  padding: 20px;

  margin-bottom: 15px;

  border-radius: var(--radius-medium);

  background: var(--dark-secondary);
}

.member-card h3 {
  color: #fda4af;

  margin-bottom: 10px;
}

.member-card p {
  margin: 5px 0;

  color: #d1d5db;

  overflow-wrap: anywhere;
}

.delete-button {
  margin-top: 12px;

  background: #dc2626;
  color: white;
}

.delete-button:hover {
  background: #b91c1c;
}

/* ================= FOOTER ================= */

footer {
  padding: 45px 8%;

  text-align: center;

  background: #030712;

  color: white;
}

footer p {
  color: #9ca3af;

  margin-top: 7px;
}

.copyright {
  margin-top: 20px;
}

/* ================= UTILITIES ================= */

.hidden {
  display: none !important;
}

/* ================= MOBILE ================= */

@media (max-width: 800px) {

  .header {
    flex-wrap: wrap;
  }

  nav {
    display: none;

    width: 100%;

    flex-direction: column;

    text-align: center;

    padding-top: 15px;
  }

  nav.open {
    display: flex;
  }

  .menu-button {
    display: block;
  }

  .announcement-banner {
    flex-direction: column;

    align-items: flex-start;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

  .ai-input-area {
    flex-direction: column;
  }

  .statistics {
    grid-template-columns: 1fr;
  }

  .dashboard-header {
    flex-direction: column;

    align-items: flex-start;
  }
}

/* ================= SMALL MOBILE ================= */

@media (max-width: 500px) {

  section {
    padding: 65px 5%;
  }

  .hero {
    padding: 65px 5%;
  }

  .hero h1 {
    font-size: clamp(40px, 12vw, 44px);
  }

  .hero p {
    font-size: 18px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-actions .button {
    width: 100%;
    text-align: center;
  }

  .success-card {
    padding: 30px 20px;
  }

  .announcement-banner {
    padding: 25px 22px;
  }
}

/* ================= REDUCED MOTION ================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
  }
}
